# Server
NODE_ENV=production
PORT=3000
ADMIN_PORT=3001
HOST=0.0.0.0

# Database
DB_PATH=/data/app.db

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_password
LOG_LEVEL=debug
ADMIN_LOG_LEVEL=debug
PUBLIC_LOG_LEVEL=info
# Session secret (must be at least 32 characters)
SESSION_SECRET=session_secret


