# Required by both servers
NODE_ENV=development
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Required by the admin server
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters

# Optional server settings
PORT=3000
HOST=0.0.0.0
ADMIN_PORT=3001
ADMIN_HOST=0.0.0.0
# SERVER_MODE=all

# Optional storage settings (defaults shown)
# STORAGE_ROOT=storage
# DB_PATH=storage/db/app.db

# Optional application URLs and logging
# SITE_URL=http://localhost:3000
# ADMIN_URL=http://localhost:3001
PUBLIC_LOG_LEVEL=info
ADMIN_LOG_LEVEL=info
