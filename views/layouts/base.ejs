<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO Meta Tags -->
  <meta name="description" content="<%= description || 'Recomte - Европейские прицепы-дачи. Продажа качественных прицепов-дач из Европы. Большой выбор моделей с доставкой.' %>">
  <meta name="keywords" content="<%= keywords || 'прицеп-дача, прицепы-дачи, европейские прицепы-дачи, кемпер, дачный прицеп' %>">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="robots" content="<%= noindex ? 'noindex' : 'index' %>, follow">
  
  <!-- Language -->
  <meta http-equiv="content-language" content="ru-RU">
  <link rel="alternate" hreflang="ru" href="https://recomte.ru<%= currentPath || '/' %>">
  
  <!-- Canonical URL -->
  <meta property="og:url" content="https://recomte.ru<%= currentPath || '/' %>">
  <link rel="canonical" href="https://recomte.ru<%= currentPath || '/' %>">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= title %> - Recomte">
  <meta property="og:description" content="<%= description || 'Европейские прицепы-дачи' %>">
  <meta property="og:image" content="<%= ogImage || 'https://recomte.ru/public/og-image.jpg' %>">
  <meta property="og:site_name" content="Recomte">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %> - Recomte">
  <meta name="twitter:description" content="<%= description || 'Европейские прицепы-дачи' %>">
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/public/images/favicon.svg">
  <title>Recomte | <%= title %></title>
  
  <!-- Stylesheets -->
  <link rel="stylesheet" href="/public/css/bulma.css">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Custom styles -->
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>

<!-- Header -->
<header class="section has-background-image" style="padding: 2rem 0;">
  <div class="container">
    <div class="header-top is-flex is-justify-content-space-between is-align-items-center">
      <div>
        <h1 class="title is-2 has-text-white mb-5"><a href="/" class="has-text-white" style="text-decoration: none;">Recomte</a></h1>
        <h2 class="subtitle is-5 has-text-white">Прицеп-дачи из Европы</h2>
      </div>
      <label for="mobile-menu-toggle" class="mobile-menu-button" aria-label="Открыть меню" aria-controls="mobile-menu">Меню</label>
      <nav class="navbar desktop-menu is-flex px-5 py-2 rounded" style="background-color: rgba(0, 0, 0, 0.8); gap: 2rem;" role="navigation">
        <a class="navbar-item has-text-white" href="/">Главная</a>
        <a class="navbar-item has-text-white" href="/caravans">Каталог</a>
        <a class="navbar-item has-text-white" href="/contact">Контакты</a>
      </nav>
    </div>
    <input id="mobile-menu-toggle" class="mobile-menu-toggle-checkbox" type="checkbox" hidden>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Мобильное меню">
      <a class="navbar-item has-text-white" href="/">Главная</a>
      <a class="navbar-item has-text-white" href="/caravans">Каталог</a>
      <a class="navbar-item has-text-white" href="/contact">Контакты</a>
    </nav>
  </div>
</header>

<!-- Main content -->
<main>
  <%- body %>
</main>

<!-- Footer -->
<footer class="footer">
  <div class="container">
    <div class="content has-text-centered">
      <p>
        <strong>Recomte.ru</strong> © <%= new Date().getFullYear() %> — Европейские прицепы-дачи
      </p>
      <p>
        <a href="/contact">Контакты</a> | 
        <a href="/">Главная</a>
      </p>
    </div>
  </div>
</footer>

</body>
</html>
