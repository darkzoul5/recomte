<%- include('layouts/header', { title: 'Каталог' }) %>

<!-- Catalogue Section -->
<section class="section">
  <div class="container">
    <h2 class="title has-text-centered">Каталог прицепов</h2>

    <% 
      let availableCaravans = caravans.filter(c => c.status !== 'sold');
      let soldCaravans = caravans.filter(c => c.status === 'sold');
    %>

    <% if (availableCaravans.length > 0) { %>
      <!-- Available campers -->
      <h3 class="subtitle mt-5">В продаже</h3>
      <div class="columns is-multiline">
        <% availableCaravans.forEach(caravan => { %>
          <div class="column is-one-third">
            <div class="card">
              <div class="card-image">
                <figure class="image is-4by3">
                  <% if (caravan.images && caravan.images.length > 0) { %>
                    <img src="<%= caravan.images[0].url %>" alt="<%= caravan.title %>" style="object-fit: cover;">
                  <% } else { %>
                    <img src="https://images.pexels.com/photos/20072445/pexels-photo-20072445.jpeg" alt="<%= caravan.title %>">
                  <% } %>
                </figure>
              </div>
              <div class="card-content">
                <h3 class="title is-5"><%= caravan.title %></h3>
                <p><%= caravan.description ? caravan.description.substring(0, 100) + '...' : 'Современный туристический кемпер для комфортных путешествий.' %></p>
                <a class="button is-success is-small mt-2" href="/caravans/<%= caravan.slug %>">Подробнее</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (soldCaravans.length > 0) { %>
      <!-- Sold campers -->
      <h3 class="subtitle mt-5">Проданные</h3>
      <div class="columns is-multiline">
        <% soldCaravans.forEach(caravan => { %>
          <div class="column is-one-third">
            <div class="card">
              <div class="card-image">
                <figure class="image is-4by3">
                  <% if (caravan.images && caravan.images.length > 0) { %>
                    <img src="<%= caravan.images[0].url %>" alt="<%= caravan.title %>" style="object-fit: cover;">
                  <% } else { %>
                    <img src="https://images.pexels.com/photos/18247305/pexels-photo-18247305.jpeg" alt="<%= caravan.title %>">
                  <% } %>
                </figure>
              </div>
              <div class="card-content">
                <h3 class="title is-5"><%= caravan.title %></h3>
                <p>Этот прицеп уже нашел своего владельца.</p>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (caravans.length === 0) { %>
      <div class="notification is-info is-light">
        <p>К сожалению, в данный момент нет доступных кемперов</p>
      </div>
    <% } %>
  </div>
</section>

<%- include('layouts/footer') %>
