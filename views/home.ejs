<%- include('layouts/header', { title: 'Главная' }) %>

<!-- Сaravans Section -->
<section class="section">
  <div class="container">
    <h2 class="title has-text-centered">Наши Прицеп-дачи</h2>
    <% if (caravans && caravans.length > 0) { %>
      <div class="columns is-multiline">
        <% caravans.forEach(caravan => { %>
          <div class="column is-one-third">
            <div class="card">
              <div class="card-image">
                <figure class="image is-4by3">
                  <% if (caravan.images && caravan.images.length > 0) { %>
                    <img src="<%= caravan.images[0].url %>" alt="<%= caravan.title %>" style="object-fit: cover;">
                  <% } else { %>
                    <img src="/public/no-image-available.png?text=<%= caravan.title %>" alt="<%= caravan.title %>" style="object-fit: contain;">
                  <% } %>
                </figure>
              </div>
              <div class="card-content">
                <h3 class="title is-5"><%= caravan.title %></h3>
                <p><%= caravan.description ? caravan.description.substring(0, 100) + '...' : 'Туристический прицеп для комфортных путешествий.' %></p>
                <a class="button is-success is-small mt-2" href="/caravans/<%= caravan.slug %>">Подробнее</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="notification is-info">
        <p>Нет предложений в данный момент</p>
      </div>
    <% } %>
  </div>
</section>

<!-- About Section -->
<section class="section has-background-success-light">
  <div class="container">
    <h2 class="title has-text-centered">О компании</h2>
    <p class="has-text-centered">
      Мы занимаемся импортом и продажей качественных прицепов из Европы. Наши прицепы проходят строгий контроль качества и полностью готовы к эксплуатации. Мы обеспечиваем поддержку на всех этапах покупки.
    </p>
  </div>
</section>

<%- include('layouts/footer') %>
