<!-- Contact Section -->
<section class="section">
  <div class="container">
    <h1 class="title mb-6">Контакты</h1>

    <div class="columns is-multiline">
      <!-- Contact Info -->
      <div class="column is-one-third">
        <div class="box">
          <h3 class="subtitle is-4 mb-4">
            <i class="fas fa-phone has-text-primary"></i> Телефон
          </h3>
          <p class="is-size-5 mb-3">
            <a href="tel:+79991234567" class="has-text-link">+7 (999) 123-45-67</a>
          </p>
          <p class="help">Доступны для звонков</p>
        </div>
      </div>

      <!-- Email -->
      <div class="column is-one-third">
        <div class="box">
          <h3 class="subtitle is-4 mb-4">
            <i class="fas fa-envelope has-text-primary"></i> Email
          </h3>
          <p class="is-size-5 mb-3">
            <a href="mailto:info@recomte.ru" class="has-text-link">info@recomte.ru</a>
          </p>
          <p class="help">Ответ в течение 24 часов</p>
        </div>
      </div>

      <!-- Hours -->
      <div class="column is-one-third">
        <div class="box">
          <h3 class="subtitle is-4 mb-4">
            <i class="fas fa-clock has-text-primary"></i> Часы работы
          </h3>
          <table class="table is-fullwidth is-narrow">
            <tbody>
              <tr>
                <td><strong>Пн-Пт:</strong></td>
                <td>10:00 — 18:00</td>
              </tr>
              <tr>
                <td><strong>Сб:</strong></td>
                <td>10:00 — 16:00</td>
              </tr>
              <tr>
                <td><strong>Вс:</strong></td>
                <td>Выходной</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="box has-background-light mt-5">
      <h2 class="subtitle is-4 mb-3">Интересуетесь кемпером?</h2>
      <p class="mb-4">
        Свяжитесь с нами по телефону или через email. Мы помогим вам найти идеальный кемпер для ваших путешествий!
      </p>
      <a href="/vehicles" class="button is-primary">
        <span class="icon">
          <i class="fas fa-arrow-left"></i>
        </span>
        <span>Вернуться к каталогу</span>
      </a>
    </div>
  </div>
</section>
