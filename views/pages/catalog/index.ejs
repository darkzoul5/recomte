<%- include('../../components/header/public', { title: 'Каталог прицепов-дач' }) %>

<%
  const getStatusLabel = (status) => {
    if (status === 'sold') return 'Продан';
    if (status === 'reserved') return 'Зарезервирован';
    return 'В наличии';
  };

  const getStatusClass = (status) => {
    if (status === 'sold') return 'is-danger';
    if (status === 'reserved') return 'is-warning';
    return 'is-success';
  };
%>

<!-- Catalogue Section -->
<section class="section">
  <div class="container">
    <h1 class="title has-text-centered">Каталог прицепов-дач</h1>

    <% if (caravans && caravans.length > 0) { %>
      <div class="columns is-multiline cards-grid">
        <% caravans.forEach(caravan => { %>
          <div class="column is-one-third">
            <div class="card">
              <div class="card-image" style="position: relative;">
                <a href="/caravans/<%= caravan.slug %>" aria-label="Открыть <%= caravan.title %>">
                  <figure class="image is-4by3">
                    <% if (caravan.images && caravan.images.length > 0) { %>
                      <img src="<%= caravan.images[0].url %>" alt="<%= caravan.title %>" style="object-fit: cover;">
                    <% } else { %>
                      <img src="/public/images/no-image-available.png" alt="<%= caravan.title %>" style="object-fit: contain;">
                    <% } %>
                  </figure>
                </a>

                <% if (caravan.status === 'sold') { %>
                  <div style="position: absolute; inset: 0; background: rgba(0, 0, 0, 0.55); display: flex; align-items: center; justify-content: center; z-index: 2;">
                    <span class="tag is-danger is-large is-uppercase has-text-weight-bold">Продано</span>
                  </div>
                <% } %>
              </div>
              <div class="card-content">
                <div class="is-flex is-justify-content-space-between is-align-items-start mb-2" style="gap: 0.75rem;">
                  <h2 class="title is-5 mb-0"><%= caravan.title %></h2>
                  <span class="tag <%= getStatusClass(caravan.status) %> is-light"><%= getStatusLabel(caravan.status) %></span>
                </div>
                <% if (caravan.brand || caravan.year) { %>
                  <p class="is-size-7 has-text-grey mb-2">
                    <% if (caravan.brand) { %><strong><%= caravan.brand %></strong><% } %>
                    <% if (caravan.brand && caravan.year) { %> · <% } %>
                    <% if (caravan.year) { %><%= caravan.year %><% } %>
                  </p>
                <% } %>
                <p><%= caravan.description ? caravan.description.substring(0, 100) + '...' : 'Современная Прицеп-дача для комфортных путешествий.' %></p>
                <% if (caravan.curb_weight_kg || caravan.gross_weight_kg) { %>
                  <p class="is-size-7 has-text-grey mt-2">
                    <% if (caravan.curb_weight_kg) { %>
                      Снаряженная: <strong><%= caravan.curb_weight_kg %> кг</strong>
                    <% } %>
                    <% if (caravan.curb_weight_kg && caravan.gross_weight_kg) { %>
                      ·
                    <% } %>
                    <% if (caravan.gross_weight_kg) { %>
                      Полная: <strong><%= caravan.gross_weight_kg %> кг</strong>
                    <% } %>
                  </p>
                <% } %>
                <% if (caravan.camper_season) { %>
                  <p class="is-size-7 has-text-grey mt-1">
                    Тип: <strong><%= caravan.camper_season === 'all_season' ? 'Всесезонный' : 'Лето' %></strong>
                  </p>
                <% } %>
                <% if (caravan.length_with_hitch_mm || caravan.length_without_hitch_mm || caravan.length_mm) { %>
                  <p class="is-size-7 has-text-grey mt-1">
                    Длина:
                    <% if (caravan.length_with_hitch_mm || caravan.length_mm) { %>
                      полная <strong><%= (((caravan.length_with_hitch_mm || caravan.length_mm)) / 1000).toFixed(2) %> м</strong>
                    <% } %>
                    <% if (caravan.length_without_hitch_mm) { %>
                      <% if (caravan.length_with_hitch_mm || caravan.length_mm) { %> · <% } %>
                      кузов <strong><%= (caravan.length_without_hitch_mm / 1000).toFixed(2) %> м</strong>
                    <% } %>
                  </p>
                <% } %>
                <div class="is-flex is-align-items-center mt-2" style="gap: 0.75rem; flex-wrap: wrap;">
                  <a class="button is-success is-small" href="/caravans/<%= caravan.slug %>">Подробнее</a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="notification is-info">
        <p>К сожалению, в данный момент в каталоге нет Прицеп-дач</p>
      </div>
    <% } %>
  </div>
</section>

<%- include('../../components/footer/public') %>
