<%- include('../../components/header/public', { title }) %>
<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org/",
  "@type": "Product",
  name: caravan.title,
  description: caravan.description || '',
  image: (caravan.images && caravan.images.length > 0) ? caravan.images.map((img) => img.url) : [],
  sku: caravan.sku || caravan.id || '',
  brand: caravan.brand ? { "@type": "Brand", name: caravan.brand } : undefined,
  seller: { "@type": "Organization", name: "Recomte" },
  offers: {
    "@type": "Offer",
    priceCurrency: "RUB",
    price: caravan.price,
    availability: caravan.status === 'sold'
      ? "https://schema.org/OutOfStock"
      : "https://schema.org/InStock",
    itemCondition: "https://schema.org/UsedCondition",
    availableDeliveryMethod: "https://schema.org/OnSitePickup",
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted"
    }
  }
}, null, 2) %>
</script>
<link rel="stylesheet" href="/public/css/caravan-gallery.css">

<%
  const getStatusLabel = (status) => {
    if (status === 'sold') return 'ПРОДАНО';
    if (status === 'reserved') return 'ЗАРЕЗЕРВИРОВАНО';
    return 'В НАЛИЧИИ';
  };

  const getStatusClass = (status) => {
    if (status === 'sold') return 'is-danger';
    if (status === 'reserved') return 'is-warning';
    return 'is-success';
  };
%>

<!-- Caravan Detail Section -->
<section class="section">
  <div class="container">
    <nav class="breadcrumb mb-5" aria-label="breadcrumbs">
      <ul>
        <li><a href="/">Главная</a></li>
        <li><a href="/caravans">Каталог</a></li>
        <li class="is-active"><a aria-current="page"><%= caravan.title %></a></li>
      </ul>
    </nav>

    <div class="columns">
      <!-- Images Gallery -->
      <div class="column is-two-thirds">
        <div class="caravan-gallery mb-5" data-caravan-gallery>
          <script type="application/json" id="caravanImagesData"><%- JSON.stringify((caravan.images || []).map((img, index) => ({
            id: img.id,
            url: img.url,
            alt: img.alt_text || `Изображение ${index + 1} для ${caravan.title}`,
            title: caravan.title,
            index: index
          }))) %></script>

          <div class="caravan-gallery__main">
            <button type="button" class="caravan-gallery__arrow caravan-gallery__arrow--prev" data-gallery-prev aria-label="Предыдущее изображение">
              <i class="fas fa-chevron-left"></i>
            </button>

            <button type="button" class="caravan-gallery__main-button" data-gallery-open aria-label="Открыть изображение в полном размере">
              <img class="caravan-gallery__main-image" data-gallery-main-image src="<%= caravan.images && caravan.images.length > 0 ? caravan.images[0].url : 'https://via.placeholder.com/800x600?text=Без+изображений' %>" alt="<%= caravan.title %>">
            </button>

            <button type="button" class="caravan-gallery__arrow caravan-gallery__arrow--next" data-gallery-next aria-label="Следующее изображение">
              <i class="fas fa-chevron-right"></i>
            </button>
          </div>

          <div class="caravan-gallery__thumbnails" data-gallery-thumbnails></div>
        </div>
      </div>

      <!-- Details Sidebar -->
      <div class="column">
        <div class="box">
          <h1 class="title is-3"><%= caravan.title %></h1>
          
          <div class="mb-5">
            <p class="is-size-5 has-text-weight-bold has-text-primary">
              <strong><%= caravan.price.toLocaleString('ru-RU') %> ₽</strong>
            </p>
            <p class="tag <%= getStatusClass(caravan.status) %> is-medium"><%= getStatusLabel(caravan.status) %></p>
          </div>

          <!-- Key specs -->
          <div class="mb-5">
            <h3 class="subtitle is-5">Основные характеристики</h3>
            <table class="table is-fullwidth is-narrow">
              <tbody>
                <% if (caravan.year) { %>
                  <tr>
                    <td><strong>Год выпуска:</strong></td>
                    <td><%= caravan.year %></td>
                  </tr>
                <% } %>
                <% if (caravan.beds_count) { %>
                  <tr>
                    <td><strong>Спальных мест:</strong></td>
                    <td><%= caravan.beds_count %></td>
                  </tr>
                <% } %>
                <% if (caravan.manufacturer_country) { %>
                  <tr>
                    <td><strong>Страна производителя:</strong></td>
                    <td><%= caravan.manufacturer_country %></td>
                  </tr>
                <% } %>
                <% if (caravan.camper_season) { %>
                  <tr>
                    <td><strong>Тип Прицеп-дачи:</strong></td>
                    <td><%= caravan.camper_season === 'all_season' ? 'Всесезонный' : 'Лето' %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Contact button -->
          <a href="/contact" class="button is-primary is-fullwidth is-medium mb-3">
            <span class="icon">
              <i class="fas fa-phone"></i>
            </span>
            <span>Связаться с нами</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Full Description -->
    <% if (caravan.description) { %>
      <div class="box mt-5">
        <h2 class="subtitle is-4">Описание</h2>
        <p><%= caravan.description %></p>
      </div>
    <% } %>

    <!-- Detailed specs if available -->
    <% if (
      caravan.shower_type || caravan.has_toilet || caravan.sink_present ||
      caravan.fridge_volume_l || caravan.fresh_water_tank_l || caravan.has_hot_water || caravan.water_heater_type || caravan.boiler_volume_l ||
      caravan.length_mm || caravan.width_mm || caravan.height_mm || caravan.interior_height_mm || caravan.curb_weight_kg || caravan.gross_weight_kg || caravan.condition ||
      (caravan.feature_map && (
        (caravan.feature_map.grill && caravan.feature_map.grill !== '0') ||
        (caravan.feature_map.awning && caravan.feature_map.awning !== '0') ||
        (caravan.feature_map.bike_rack && caravan.feature_map.bike_rack !== '0') ||
        (caravan.feature_map.mosquito_nets && caravan.feature_map.mosquito_nets !== '0') ||
        (caravan.feature_map.tv_mount && caravan.feature_map.tv_mount !== '0') ||
        (caravan.feature_map.air_conditioning && caravan.feature_map.air_conditioning !== '0')
      ))
    ) { %>
      <div class="box mt-5">
        <h2 class="subtitle is-4">Детальные характеристики</h2>
        
        <div class="columns is-multiline">
          <!-- Bathroom -->
          <% if (caravan.shower_type || caravan.has_toilet || caravan.sink_present) { %>
            <div class="column is-one-third">
                <h4 class="subtitle is-6 has-text-weight-bold">Ванная</h4>
              <ul>
                <% if (caravan.shower_type) { %><li>Душ: <%= caravan.shower_type === 'none' ? 'Нет' : (caravan.shower_type === 'separate' ? 'Отдельно от туалета' : 'Совмещен с туалетом') %></li><% } %>
                <% if (caravan.has_toilet) { %><li><i class="fas fa-check has-text-success"></i> Туалет</li><% } %>
                <% if (caravan.sink_present) { %><li><i class="fas fa-check has-text-success"></i> Раковина в ванной</li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.bed_types || caravan.windows_count || caravan.door_position) { %>
            <div class="column is-one-third">
                <h4 class="subtitle is-6 has-text-weight-bold">Планировка</h4>
              <ul>
                <% if (caravan.bed_types && caravan.bed_types.length > 0) { %>
                  <% 
                    const bedTypeLabels = {
                      bunk: { one: 'двухъярусная', many: 'двухъярусные' },
                      twin: { one: 'раздельная', many: 'раздельные' },
                      dinette: { one: 'трансформер из стола', many: 'трансформеры из стола' },
                      double: { one: 'двуспальная', many: 'двуспальные' }
                    };

                    const bedCounts = new Map();
                    caravan.bed_types.forEach((type) => {
                      bedCounts.set(type, (bedCounts.get(type) || 0) + 1);
                    });

                    const bedTypesText = Array.from(bedCounts.entries())
                      .map(([type, count]) => {
                        const labels = bedTypeLabels[type] || { one: type, many: type };
                        return count > 1 ? `${count} ${labels.many}` : labels.one;
                      })
                      .join(', ');
                  %>
                  <li>Кровати: <%= bedTypesText %></li>
                <% } %>
                <% if (caravan.windows_count) { %><li>Окон: <%= caravan.windows_count %></li><% } %>
                <% if (caravan.door_position) { %><li>Дверь: <%= caravan.door_position === 'left' ? 'Левая' : (caravan.door_position === 'right' ? 'Правая' : 'С обеих сторон') %></li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.fresh_water_tank_l || caravan.grey_water_tank_l || caravan.has_hot_water || caravan.water_heater_type || caravan.boiler_volume_l) { %>
            <div class="column is-one-third">
                <h4 class="subtitle is-6 has-text-weight-bold">Водная система</h4>
              <ul>
                <% if (caravan.fresh_water_tank_l) { %><li>Пресная вода: <%= caravan.fresh_water_tank_l %> л</li><% } %>
                <% if (caravan.grey_water_tank_l) { %><li>Серая вода: <%= caravan.grey_water_tank_l %> л</li><% } %>
                <% if (caravan.has_hot_water) { %><li><i class="fas fa-check has-text-success"></i> Горячая вода</li><% } %>
                <% if (caravan.water_heater_type_values && caravan.water_heater_type_values.length > 0) { %>
                  <li>Бойлер: <%= caravan.water_heater_type_values.join(', ') %></li>
                <% } else if (caravan.water_heater_type) { %>
                  <li>Бойлер: <%= caravan.water_heater_type %></li>
                <% } %>
                <% if (caravan.boiler_volume_l) { %><li>Объём бойлера: <%= caravan.boiler_volume_l %> л</li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.fridge_volume_l || (caravan.fridge_type_values && caravan.fridge_type_values.length > 0) || caravan.stove_burners_count || (caravan.kitchen_appliances_values && caravan.kitchen_appliances_values.length > 0)) { %>
            <div class="column is-one-third">
                <h4 class="subtitle is-6 has-text-weight-bold">Кухня</h4>
              <ul>
                <% if (caravan.fridge_volume_l) { %><li>Холодильник: <%= caravan.fridge_volume_l %> л</li><% } %>
                <% if (caravan.fridge_type_values && caravan.fridge_type_values.length > 0) { %><li>Питание холодильника: <%= caravan.fridge_type_values.join(', ') %></li><% } %>
                <% if (caravan.stove_burners_count && caravan.stove_burners_count > 0) { %><li><i class="fas fa-check has-text-success"></i> Плита: <%= caravan.stove_burners_count %> конфорок</li><% } %>
                <% if (caravan.kitchen_appliances_values && caravan.kitchen_appliances_values.includes('microwave')) { %><li><i class="fas fa-check has-text-success"></i> Микроволновка</li><% } %>
                <% if (caravan.kitchen_appliances_values && caravan.kitchen_appliances_values.includes('oven')) { %><li><i class="fas fa-check has-text-success"></i> Духовка</li><% } %>
                <% if (caravan.kitchen_appliances_values && caravan.kitchen_appliances_values.includes('grill')) { %><li><i class="fas fa-check has-text-success"></i> Гриль</li><% } %>
              </ul>
            </div>
          <% } %>

          <% if ((caravan.heating_type_values && caravan.heating_type_values.length > 0) || caravan.has_ac || (caravan.feature_map && caravan.feature_map.air_conditioning && caravan.feature_map.air_conditioning !== '0') || caravan.vent_fans_count || caravan.skylights_count || caravan.heating_distribution || caravan.heater_brand || caravan.double_glazed_windows) { %>
            <div class="column is-one-third">
                <h4 class="subtitle is-6 has-text-weight-bold">Климат и отопление</h4>
              <ul>
                <% if (caravan.heating_type_values && caravan.heating_type_values.length > 0) { %><li><i class="fas fa-check has-text-success"></i> Отопление: <%= caravan.heating_type_values.map((value) => value === 'diesel' ? 'Дизельное' : (value === 'gas' ? 'Газовое' : 'Электрическое')).join(', ') %></li><% } %>
                <% if (caravan.heating_distribution) { %><li>Распределение тепла: <%= caravan.heating_distribution === 'liquid' ? 'Жидкостное' : 'Воздушное' %></li><% } %>
                <% if (caravan.heater_brand) { %><li>Бренд котла: <%= caravan.heater_brand %></li><% } %>
                <% if (caravan.camper_season) { %><li>Тип: <%= caravan.camper_season === 'all_season' ? 'Всесезонный' : 'Лето' %></li><% } %>
                <% if (caravan.has_ac || (caravan.feature_map && caravan.feature_map.air_conditioning && caravan.feature_map.air_conditioning !== '0')) { %><li><i class="fas fa-check has-text-success"></i> Кондиционер</li><% } %>
                <% if (caravan.vent_fans_count) { %><li>Вентиляторов: <%= caravan.vent_fans_count %></li><% } %>
                <% if (caravan.skylights_count) { %><li>Люков: <%= caravan.skylights_count %></li><% } %>
                <% if (caravan.double_glazed_windows) { %><li><i class="fas fa-check has-text-success"></i> Двойное остекление</li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.feature_map && ((caravan.feature_map.awning && caravan.feature_map.awning !== '0') || (caravan.feature_map.bike_rack && caravan.feature_map.bike_rack !== '0') || (caravan.feature_map.mosquito_nets && caravan.feature_map.mosquito_nets !== '0') || (caravan.feature_map.tv_mount && caravan.feature_map.tv_mount !== '0'))) { %>
            <div class="column is-one-third">
                <h4 class="subtitle is-6 has-text-weight-bold">Оснащение</h4>
              <ul>
                <% if (caravan.feature_map.awning && caravan.feature_map.awning !== '0') { %><li><i class="fas fa-check has-text-success"></i> Маркиза</li><% } %>
                <% if (caravan.feature_map.bike_rack && caravan.feature_map.bike_rack !== '0') { %><li><i class="fas fa-check has-text-success"></i> Велостойка</li><% } %>
                <% if (caravan.feature_map.mosquito_nets && caravan.feature_map.mosquito_nets !== '0') { %><li><i class="fas fa-check has-text-success"></i> Москитные сетки</li><% } %>
                <% if (caravan.feature_map.tv_mount && caravan.feature_map.tv_mount !== '0') { %><li><i class="fas fa-check has-text-success"></i> ТВ-кронштейн</li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.battery_type || caravan.solar_wattage || caravan.inverter_wattage || caravan.has_12v_system) { %>
            <div class="column is-one-third">
                <h4 class="subtitle is-6 has-text-weight-bold">Электричество</h4>
              <ul>
                <% if (caravan.battery_type) { %><li>Батарея: <%= caravan.battery_type === 'lead-acid' ? 'Свинцово-кислотная' : (caravan.battery_type === 'lithium' ? 'Литиевая' : caravan.battery_type) %></li><% } %>
                <% if (caravan.battery_capacity_ah) { %><li>Ёмкость: <%= caravan.battery_capacity_ah %> Ач</li><% } %>
                <% if (caravan.solar_wattage) { %><li>Солнечные панели: <%= caravan.solar_wattage %> W</li><% } %>
                <% if (caravan.inverter_wattage) { %><li>Инвертор: <%= caravan.inverter_wattage %> W</li><% } %>
                <% if (caravan.has_12v_system) { %><li><i class="fas fa-check has-text-success"></i> 12V система</li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.axles_count || caravan.brake_type) { %>
            <div class="column is-one-third">
                <h4 class="subtitle is-6 has-text-weight-bold">Шасси и буксировка</h4>
              <ul>
                <% if (caravan.axles_count) { %><li>Осей: <%= caravan.axles_count %></li><% } %>
                <% if (caravan.brake_type) { %><li>Тормоза: <%= caravan.brake_type === 'hydraulic' ? 'Гидравлические' : (caravan.brake_type === 'electric' ? 'Электрические' : 'Барабанные') %></li><% } %>
                <% if (caravan.suspension_type) { %><li>Подвеска: <%= caravan.suspension_type === 'leaf_spring' ? 'Рессоры' : (caravan.suspension_type === 'coil_spring' ? 'Пружины' : (caravan.suspension_type === 'air_suspension' ? 'Пневматическая' : (caravan.suspension_type === 'independent' ? 'Независимая' : caravan.suspension_type))) %></li><% } %>
                <% if (caravan.wheel_size_inch) { %><li>Колеса: <%= caravan.wheel_size_inch %>"</li><% } %>
                <% if (caravan.hitch_weight_kg) { %><li>Нагрузка на сцепку: <%= caravan.hitch_weight_kg %> кг</li><% } %>
                <% if (caravan.braked) { %><li><i class="fas fa-check has-text-success"></i> С тормозами на оси</li><% } %>
                <% if (caravan.stabilizer_present) { %><li><i class="fas fa-check has-text-success"></i> Стабилизатор</li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.length_mm || caravan.width_mm || caravan.height_mm || caravan.interior_height_mm || caravan.curb_weight_kg || caravan.gross_weight_kg) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6 has-text-weight-bold">Размеры и масса</h4>
              <ul>
                <% if (caravan.length_mm) { %><li>Длина: <%= (caravan.length_mm / 1000).toFixed(2) %> м</li><% } %>
                <% if (caravan.width_mm) { %><li>Ширина: <%= caravan.width_mm %> мм</li><% } %>
                <% if (caravan.height_mm) { %><li>Высота: <%= caravan.height_mm %> мм</li><% } %>
                <% if (caravan.interior_height_mm) { %><li>Внутренняя высота: <%= caravan.interior_height_mm %> мм</li><% } %>
                <% if (caravan.curb_weight_kg) { %><li>Снаряженная масса: <%= caravan.curb_weight_kg %> кг</li><% } %>
                <% if (caravan.gross_weight_kg) { %><li>Полная масса: <%= caravan.gross_weight_kg %> кг</li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.condition || caravan.last_service_date) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6 has-text-weight-bold">Состояние и история</h4>
              <ul>
                <% if (caravan.condition) { %><li>Состояние: <%= caravan.condition === 'excellent' ? 'Отличное' : (caravan.condition === 'good' ? 'Хорошее' : (caravan.condition === 'fair' ? 'Удовлетворительное' : 'Требует ремонта')) %></li><% } %>
                <% if (caravan.last_service_date) { %><li>Последнее обслуживание: <%= new Date(caravan.last_service_date).toLocaleDateString('ru-RU') %></li><% } %>
              </ul>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script src="/public/js/caravan-gallery.js"></script>

<%- include('../../components/footer/public') %>
