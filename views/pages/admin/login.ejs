<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= siteHost %> | Вход</title>
  
  <link rel="icon" type="image/png" sizes="16x16" href="/public/images/favicons/favicon-orange-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/public/images/favicons/favicon-orange-32x32.png">
  <link rel="icon" type="image/png" sizes="180x180" href="/public/images/favicons/favicon-orange-180x180.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/public/images/favicons/favicon-orange-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/public/images/favicons/favicon-orange-512x512.png">
  
  <link rel="stylesheet" href="/public/css/website.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/public/css/bulma.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="stylesheet" href="/public/css/style.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/public/css/admin.css?v=<%= assetVersion %>">
</head>
<body>

<div class="admin-login-container">
  <div class="login-box">
    <!-- Header -->
    <div class="login-header">
      <h1>
        <i class="fas fa-lock"></i>
        Админ панель
      </h1>
    </div>

    <!-- Form -->
    <div class="login-form">
      <% if (error) { %>
        <div class="error-message">
          <span><%= error %></span>
          <button class="delete" type="button"></button>
        </div>
      <% } %>

      <form method="POST" action="/admin/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
        <div class="field">
          <label class="label">
            Логин
          </label>
          <div class="control has-icons-left">
            <input 
              class="input" 
              type="text" 
              name="username" 
              placeholder="Введите логин" 
              value="<%= username || '' %>"
              required 
              <%= username ? '' : 'autofocus' %>
            >
            <span class="icon is-small is-left">
              <i class="fas fa-user"></i>
            </span>
          </div>
        </div>

        <div class="field">
          <label class="label">
            Пароль
          </label>
          <div class="control has-icons-left">
            <input 
              class="input" 
              type="password" 
              id="admin-password"
              name="password" 
              placeholder="Введите пароль" 
              aria-describedby="caps-lock-hint"
              required 
              <%= username ? 'autofocus' : '' %>
            >
            <span class="icon is-small is-left">
              <i class="fas fa-key"></i>
            </span>
          </div>
          <p id="caps-lock-hint" class="caps-lock-hint" hidden>
            <i class="fas fa-triangle-exclamation"></i>
            <span>Caps Lock включен</span>
          </p>
        </div>

        <button type="submit" class="login-button">
          <i class="fas fa-sign-in-alt"></i>
          <span>Войти</span>
        </button>
      </form>
    </div>

    <!-- Footer -->
    <div class="login-footer">
      <p>© 2026 Recomte.ru</p>
    </div>
  </div>
</div>

<script src="/public/js/admin-shell.js?v=<%= assetVersion %>"></script>
