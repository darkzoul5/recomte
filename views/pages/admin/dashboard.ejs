<%- include('../../components/header/admin', { title: 'Панель управления' }) %>

    <!-- Dashboard Header -->
    <div class="admin-header">
      <h1><i class="fas fa-th-list"></i> Панель управления</h1>
      <a href="https://webmaster.yandex.ru/siteinfo/?site=<%= encodeURIComponent(siteUrl) %>"><img width="88" height="31" alt="" border="0" border-radius="8" src="https://yandex.ru/cycounter?<%= encodeURIComponent(siteUrl) %>&theme=light&lang=ru"/></a>
    </div>

    <!-- Stats -->
    <div class="admin-stats">
      <div class="admin-stat-box">
        <div class="stat-label">Всего</div>
        <div class="stat-value"><%= caravans.length %></div>
      </div>
      <div class="admin-stat-box">
        <div class="stat-label">В наличии</div>
        <div class="stat-value"><%= caravans.filter(c => c.status === 'available').length %></div>
      </div>
      <div class="admin-stat-box">
        <div class="stat-label">Зарезервировано</div>
        <div class="stat-value"><%= caravans.filter(c => c.status === 'reserved').length %></div>
      </div>
      <div class="admin-stat-box">
        <div class="stat-label">Продано</div>
        <div class="stat-value"><%= caravans.filter(c => c.status === 'sold').length %></div>
      </div>
      <div class="admin-stat-box">
        <div class="stat-label">Скрыто</div>
        <div class="stat-value"><%= caravans.filter(c => c.status === 'hidden').length %></div>
      </div>
    </div>

    <!-- Add Button -->
    <div style="margin-bottom: 2rem;">
      <a href="/admin/new" class="button is-success">
        <span class="icon"><i class="fas fa-plus"></i></span>
        <span>Добавить</span>
      </a>
    </div>

    <!-- Caravans Table -->
    <% if (caravans && caravans.length > 0) { %>
      <div class="admin-table-wrapper">
        <table class="admin-table table is-fullwidth">
          <thead>
            <tr>
              <th>Название</th>
              <th>Год</th>
              <th>Цена</th>
              <th>Статус</th>
              <th>Изображений</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% caravans.forEach(caravan => { %>
              <tr>
                <td>
                  <strong><%= caravan.title %></strong>
                  <br>
                  <small style="color: #7a7a7a;"><%= caravan.slug %></small>
                </td>
                <td><%= caravan.year || '-' %></td>
                <td><%= caravan.price ? caravan.price.toLocaleString('ru-RU') + ' ₽' : '-' %></td>
                <td>
                  <% if (caravan.status === 'sold') { %>
                    <span class="status-badge status-sold">ПРОДАНО</span>
                  <% } else if (caravan.status === 'hidden') { %>
                    <span class="status-badge">СКРЫТО</span>
                  <% } else if (caravan.status === 'reserved') { %>
                    <span class="status-badge status-reserved">ЗАРЕЗЕРВИРОВАНО</span>
                  <% } else { %>
                    <span class="status-badge status-available">В НАЛИЧИИ</span>
                  <% } %>
                </td>
                <td>
                  <% const imgCount = caravan.images ? caravan.images.length : 0; %>
                  <span style="color: #3273dc; font-weight: 600;"><%= imgCount %>/30</span>
                </td>
                <td>
                  <div class="admin-actions">
                    <a href="/admin/edit/<%= caravan.id %>" class="button is-info is-light is-small">
                      <span class="icon"><i class="fas fa-edit"></i></span>
                      <span>Редактировать</span>
                    </a>
                    <a href="<%= siteUrl %>/caravans/<%= caravan.slug %>" target="_blank" rel="noopener noreferrer" class="button is-success is-light is-small">
                      <span class="icon"><i class="fas fa-external-link-alt"></i></span>
                      <span>Просмотр на сайте</span>
                    </a>
                    <form method="POST" action="/admin/delete/<%= caravan.id %>" style="display: inline;" class="delete-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
                      <button type="submit" class="button is-danger is-light is-small">
                        <span class="icon"><i class="fas fa-trash"></i></span>
                        <span>Удалить</span>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div style="background-color: #e8f4f8; border-left: 4px solid #3273dc; border-radius: 3px; padding: 1.5rem; color: #004080;">
        <p><strong>Информация:</strong> Нет Прицеп-дач в базе. <a href="/admin/new" style="color: #0056b3; text-decoration: underline;">Добавьте первую страницу</a></p>
      </div>
    <% } %>

<script src="/public/js/admin-dashboard.js?v=<%= assetVersion %>"></script>

<%- include('../../components/footer/admin') %>
