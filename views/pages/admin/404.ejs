<%- include('../../components/header/admin', { title: 'Страница не найдена', csrfToken }) %>

    <div class="admin-not-found">
      <div class="admin-not-found__card">
        <p class="admin-not-found__eyebrow">404</p>
        <h1 class="admin-not-found__title">Страница не найдена</h1>
