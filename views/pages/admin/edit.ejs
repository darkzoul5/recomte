<%- include('../../components/header/admin', { title: isNew ? 'Новая Прицеп-дача' : 'Редактировать' }) %>

<link rel="stylesheet" href="/public/vendor/filepond/filepond.min.css">
<link rel="stylesheet" href="/public/vendor/filepond-plugin-image-preview/filepond-plugin-image-preview.min.css">

<div class="admin-header">
  <h1><i class="fas fa-edit"></i> <%= isNew ? 'Новая Прицеп-дача' : 'Редактировать: ' + caravan.title %></h1>
</div>

<% if (caravan && (caravan.created_at || caravan.updated_at)) { %>
  <div style="margin: -0.75rem 0 1.25rem; font-size: 0.85rem; color: #6b7280; line-height: 1.4;">
    <div>
      <strong>Создано:</strong> <%= caravan.created_at ? new Date(caravan.created_at).toLocaleString('ru-RU') : '-' %>
    </div>
    <div>
      <strong>Обновлено:</strong> <%= caravan.updated_at ? new Date(caravan.updated_at).toLocaleString('ru-RU') : '-' %>
    </div>
  </div>
<% } %>

<% if (error && typeof error !== 'undefined') { %>
  <div class="admin-error">
    <button class="delete"></button>
    <%= error %>
  </div>
<% } %>

<form method="POST" action="<%= isNew ? '/admin/new' : '/admin/edit/' + caravan.id %>" class="admin-form admin-form--sticky-actions" enctype="multipart/form-data">
  <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
  <div class="form-section">
    <h3><i class="fas fa-info-circle"></i> Основная информация</h3>

    <div class="form-row">
      <div class="form-group">
        <label>Название</label>
        <input type="text" name="title" value="<%= caravan?.title || '' %>" required>
      </div>
      <div class="form-group">
        <label>Slug</label>
        <input type="text" name="slug" value="<%= caravan?.slug || '' %>" required>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group" style="grid-column: 1 / -1;">
        <label>Описание</label>
        <textarea name="description" placeholder="Подробное описание Прицеп-дачи"><%= caravan?.description || '' %></textarea>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Цена (₽)</label>
        <input type="number" name="price" value="<%= caravan?.price || '' %>" step="10" required>
      </div>
      <div class="form-group">
        <label>Год выпуска</label>
        <input type="number" name="year" value="<%= caravan?.year || '' %>" min="1950" max="2040">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Статус</label>
        <select name="status">
          <option value="available" <%= caravan?.status === 'available' ? 'selected' : '' %>>В наличии</option>
          <option value="reserved" <%= caravan?.status === 'reserved' ? 'selected' : '' %>>Зарезервировано</option>
          <option value="sold" <%= caravan?.status === 'sold' ? 'selected' : '' %>>Продано</option>
          <option value="hidden" <%= caravan?.status === 'hidden' ? 'selected' : '' %>>Скрыто</option>
        </select>
      </div>
      <div class="form-group">
        <label style="font-weight: normal;">
          <input type="checkbox" name="featured" <%= caravan?.featured ? 'checked' : '' %>>
          Показывать на главной
        </label>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Страна производителя</label>
        <select name="manufacturer_country">
          <option value="">Выбрать...</option>
          <option value="Австрия" <%= caravan?.manufacturer_country === 'Австрия' ? 'selected' : '' %>>Австрия</option>
          <option value="Бельгия" <%= caravan?.manufacturer_country === 'Бельгия' ? 'selected' : '' %>>Бельгия</option>
          <option value="Великобритания" <%= caravan?.manufacturer_country === 'Великобритания' ? 'selected' : '' %>>Великобритания</option>
          <option value="Германия" <%= caravan?.manufacturer_country === 'Германия' ? 'selected' : '' %>>Германия</option>
          <option value="Дания" <%= caravan?.manufacturer_country === 'Дания' ? 'selected' : '' %>>Дания</option>
          <option value="Испания" <%= caravan?.manufacturer_country === 'Испания' ? 'selected' : '' %>>Испания</option>
          <option value="Франция" <%= caravan?.manufacturer_country === 'Франция' ? 'selected' : '' %>>Франция</option>
          <option value="Италия" <%= caravan?.manufacturer_country === 'Италия' ? 'selected' : '' %>>Италия</option>
          <option value="Швеция" <%= caravan?.manufacturer_country === 'Швеция' ? 'selected' : '' %>>Швеция</option>
          <option value="Норвегия" <%= caravan?.manufacturer_country === 'Норвегия' ? 'selected' : '' %>>Норвегия</option>
          <option value="Нидерланды" <%= caravan?.manufacturer_country === 'Нидерланды' ? 'selected' : '' %>>Нидерланды</option>
          <option value="Польша" <%= caravan?.manufacturer_country === 'Польша' ? 'selected' : '' %>>Польша</option>
          <option value="Россия" <%= caravan?.manufacturer_country === 'Россия' ? 'selected' : '' %>>Россия</option>
          <option value="Финляндия" <%= caravan?.manufacturer_country === 'Финляндия' ? 'selected' : '' %>>Финляндия</option>
          <option value="Чехия" <%= caravan?.manufacturer_country === 'Чехия' ? 'selected' : '' %>>Чехия</option>
          <option value="Другое" <%= caravan?.manufacturer_country === 'Другое' ? 'selected' : '' %>>Другое</option>
        </select>
      </div>
      <div class="form-group">
        <label>Спальных мест</label>
        <input type="number" name="beds_count" value="<%= caravan?.beds_count || '' %>">
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-door-open"></i> Планировка</h3>
    <div class="form-row">
      <div class="form-group" style="flex: 2;">
        <label>Типы кроватей</label>
        <div id="bedTypesContainer" style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1rem;">
          <!-- Bed rows are rendered by bed-types.js -->
        </div>
        <button type="button" id="addBedRowBtn" class="button is-info is-light is-small">
          <span class="icon"><i class="fas fa-plus"></i></span>
          <span>Добавить кровать</span>
        </button>
        <input type="hidden" name="bed_types_json" id="bedTypesInput" value="<%= caravan?.bed_types ? JSON.stringify(caravan.bed_types) : '[]' %>">
      </div>
      <div class="form-group">
        <label>Количество окон</label>
        <input type="number" name="windows_count" value="<%= caravan?.windows_count || '' %>" min="0">
        <label style="margin-top: 0.75rem;">Позиция двери</label>
        <select name="door_position">
          <option value="">Выбрать...</option>
          <option value="left" <%= caravan?.door_position === 'left' ? 'selected' : '' %>>Левая</option>
          <option value="right" <%= caravan?.door_position === 'right' ? 'selected' : '' %>>Правая</option>
          <option value="both" <%= caravan?.door_position === 'both' ? 'selected' : '' %>>С обеих сторон</option>
        </select>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-bath"></i> Ванная</h3>
    <div class="form-row">
      <div class="form-group">
        <label>Тип душа</label>
        <select name="shower_type">
          <option value="">Выбрать...</option>
          <option value="none" <%= caravan?.shower_type === 'none' ? 'selected' : '' %>>Нет</option>
          <option value="separate" <%= caravan?.shower_type === 'separate' ? 'selected' : '' %>>Отдельно от туалета</option>
          <option value="combined" <%= caravan?.shower_type === 'combined' ? 'selected' : '' %>>Совмещен с туалетом</option>
        </select>
      </div>
      <div class="form-group">
        <label style="font-weight: normal;"><input type="checkbox" name="has_toilet" <%= caravan?.has_toilet ? 'checked' : '' %>> Туалет</label>
        <label style="font-weight: normal;"><input type="checkbox" name="sink_present" <%= caravan?.sink_present ? 'checked' : '' %>> Раковина в ванной</label>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-water"></i> Водная система</h3>
    <div class="form-row">
      <div class="form-group">
        <label>Бак пресной воды (л)</label>
        <input type="number" name="fresh_water_tank_l" value="<%= caravan?.fresh_water_tank_l || '' %>">
      </div>
      <div class="form-group">
        <label>Бак серой воды (л)</label>
        <input type="number" name="grey_water_tank_l" value="<%= caravan?.grey_water_tank_l || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label style="font-weight: normal;"><input type="checkbox" name="has_hot_water" <%= caravan?.has_hot_water ? 'checked' : '' %>> Горячая вода</label>
      </div>
      <div class="form-group">
        <label>Тип бойлера</label>
        <select name="water_heater_type">
          <option value="">Выбрать...</option>
          <option value="electric" <%= caravan?.water_heater_type === 'electric' ? 'selected' : '' %>>Электрический</option>
          <option value="gas" <%= caravan?.water_heater_type === 'gas' ? 'selected' : '' %>>Газовый</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Объём бойлера (л)</label>
        <input type="number" name="boiler_volume_l" value="<%= caravan?.boiler_volume_l || '' %>">
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-utensils"></i> Кухня</h3>
    <div class="form-row">
      <div class="form-group">
        <label>Объём холодильника (л)</label>
        <input type="number" name="fridge_volume_l" value="<%= caravan?.fridge_volume_l || '' %>">
      </div>
      <div class="form-group">
        <label>Питание холодильника (можно несколько)</label>
        <select name="fridge_type" multiple size="2">
          <option value="electric" <%= caravan?.fridge_type_values && caravan.fridge_type_values.includes('electric') ? 'selected' : '' %>>Электричество</option>
          <option value="gas" <%= caravan?.fridge_type_values && caravan.fridge_type_values.includes('gas') ? 'selected' : '' %>>Газ</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Количество конфорок</label>
        <input type="number" name="stove_burners_count" value="<%= caravan?.stove_burners_count || '' %>">
      </div>
      <div class="form-group">
        <label>Техника (можно несколько)</label>
        <select name="kitchen_appliances" multiple size="2">
          <option value="microwave" <%= caravan?.kitchen_appliances_values && caravan.kitchen_appliances_values.includes('microwave') ? 'selected' : '' %>>Микроволновка</option>
          <option value="oven" <%= caravan?.kitchen_appliances_values && caravan.kitchen_appliances_values.includes('oven') ? 'selected' : '' %>>Духовка</option>
        </select>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-fire"></i> Отопление и сезон</h3>
    <div class="form-row">
      <div class="form-group">
        <label>Тип Прицеп-дачи</label>
        <select name="camper_season">
          <option value="summer" <%= caravan?.camper_season === 'summer' ? 'selected' : '' %>>Лето</option>
          <option value="winter" <%= caravan?.camper_season === 'winter' ? 'selected' : '' %>>Зима</option>
        </select>
      </div>
      <div class="form-group">
        <label>Тип отопления (можно несколько)</label>
        <select name="heating_type" multiple size="3">
          <option value="diesel" <%= caravan?.heating_type_values && caravan.heating_type_values.includes('diesel') ? 'selected' : '' %>>Дизельное</option>
          <option value="gas" <%= caravan?.heating_type_values && caravan.heating_type_values.includes('gas') ? 'selected' : '' %>>Газовое</option>
          <option value="electric" <%= caravan?.heating_type_values && caravan.heating_type_values.includes('electric') ? 'selected' : '' %>>Электрическое</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Тип распределения тепла</label>
        <select name="heating_distribution">
          <option value="">Выбрать...</option>
          <option value="liquid" <%= caravan?.heating_distribution === 'liquid' ? 'selected' : '' %>>Жидкостное</option>
          <option value="air" <%= caravan?.heating_distribution === 'air' ? 'selected' : '' %>>Воздушное</option>
        </select>
      </div>
      <div class="form-group">
        <label>Марка отопительного котла</label>
        <input type="text" name="heater_brand" value="<%= caravan?.heater_brand || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label style="font-weight: normal;"><input type="checkbox" name="double_glazed_windows" <%= caravan?.double_glazed_windows ? 'checked' : '' %>> Двойное остекление</label>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-plug"></i> Электроснабжение</h3>
    <div class="form-row">
      <div class="form-group">
        <label>Тип батареи</label>
        <select name="battery_type">
          <option value="">Выбрать...</option>
          <option value="lead-acid" <%= caravan?.battery_type === 'lead-acid' ? 'selected' : '' %>>Свинцово-кислотная</option>
          <option value="lithium" <%= caravan?.battery_type === 'lithium' ? 'selected' : '' %>>Литиевая</option>
        </select>
      </div>
      <div class="form-group">
        <label>Ёмкость батареи (Ач)</label>
        <input type="number" name="battery_capacity_ah" value="<%= caravan?.battery_capacity_ah || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Мощность солнечных панелей (W)</label>
        <input type="number" name="solar_wattage" value="<%= caravan?.solar_wattage || '' %>">
      </div>
      <div class="form-group">
        <label>Инвертор (W)</label>
        <input type="number" name="inverter_wattage" value="<%= caravan?.inverter_wattage || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label style="font-weight: normal;"><input type="checkbox" name="has_12v_system" <%= caravan?.has_12v_system ? 'checked' : '' %>> 12V система</label>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-link"></i> Шасси и буксировка</h3>
    <div class="form-row">
      <div class="form-group">
        <label>Количество осей</label>
        <input type="number" name="axles_count" value="<%= caravan?.axles_count || '' %>" min="1">
      </div>
      <div class="form-group">
        <label>Тип тормозов</label>
        <select name="brake_type">
          <option value="">Выбрать...</option>
          <option value="hydraulic" <%= caravan?.brake_type === 'hydraulic' ? 'selected' : '' %>>Гидравлические</option>
          <option value="electric" <%= caravan?.brake_type === 'electric' ? 'selected' : '' %>>Электрические</option>
          <option value="drum" <%= caravan?.brake_type === 'drum' ? 'selected' : '' %>>Барабанные</option>
          <option value="none" <%= caravan?.brake_type === 'none' ? 'selected' : '' %>>Нет</option>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Тип подвески</label>
        <select name="suspension_type">
          <option value="">Выбрать...</option>
          <option value="leaf_spring" <%= caravan?.suspension_type === 'leaf_spring' ? 'selected' : '' %>>Рессоры</option>
          <option value="coil_spring" <%= caravan?.suspension_type === 'coil_spring' ? 'selected' : '' %>>Пружины</option>
          <option value="air_suspension" <%= caravan?.suspension_type === 'air_suspension' ? 'selected' : '' %>>Пневматическая</option>
          <option value="independent" <%= caravan?.suspension_type === 'independent' ? 'selected' : '' %>>Независимая</option>
        </select>
      </div>
      <div class="form-group">
        <label>Размер колеса (дюймы)</label>
        <input type="number" name="wheel_size_inch" value="<%= caravan?.wheel_size_inch || '' %>" min="10" max="22">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label style="font-weight: normal;"><input type="checkbox" name="braked" <%= caravan?.braked ? 'checked' : '' %>> С тормозами на оси</label>
      </div>
      <div class="form-group">
        <label style="font-weight: normal;"><input type="checkbox" name="stabilizer_present" <%= caravan?.stabilizer_present ? 'checked' : '' %>> Стабилизатор</label>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-history"></i> Состояние и сервис</h3>
    <div class="form-row">
      <div class="form-group">
        <label>Состояние</label>
        <select name="condition">
          <option value="">Выбрать...</option>
          <option value="excellent" <%= caravan?.condition === 'excellent' ? 'selected' : '' %>>Отличное</option>
          <option value="good" <%= caravan?.condition === 'good' ? 'selected' : '' %>>Хорошее</option>
          <option value="fair" <%= caravan?.condition === 'fair' ? 'selected' : '' %>>Удовлетворительное</option>
          <option value="needs_work" <%= caravan?.condition === 'needs_work' ? 'selected' : '' %>>Требует ремонта</option>
        </select>
      </div>
      <div class="form-group">
        <label>Дата последнего обслуживания</label>
        <input type="date" name="last_service_date" value="<%= caravan?.last_service_date || '' %>">
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-ruler"></i> Размеры и масса</h3>
    <div class="form-row">
      <div class="form-group">
        <label>Длина (мм)</label>
        <input type="number" name="length_mm" value="<%= caravan?.length_mm || '' %>">
      </div>
      <div class="form-group">
        <label>Ширина (мм)</label>
        <input type="number" name="width_mm" value="<%= caravan?.width_mm || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Высота (мм)</label>
        <input type="number" name="height_mm" value="<%= caravan?.height_mm || '' %>">
      </div>
      <div class="form-group">
        <label>Внутренняя высота (мм)</label>
        <input type="number" name="interior_height_mm" value="<%= caravan?.interior_height_mm || '' %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Снаряженная масса (кг)</label>
        <input type="number" id="curbWeightInput" name="curb_weight_kg" value="<%= caravan?.curb_weight_kg || '' %>">
      </div>
      <div class="form-group">
        <label>Полная масса (кг)</label>
        <input type="number" id="grossWeightInput" name="gross_weight_kg" value="<%= caravan?.gross_weight_kg || '' %>">
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-star"></i> Дополнительные опции</h3>

    <div class="form-row">
      <div class="form-group">
        <label style="font-weight: normal;"><input type="checkbox" name="features_air_conditioning" <%= caravan?.features && caravan.features.includes('air_conditioning') ? 'checked' : '' %>> Кондиционер</label>
        <label style="font-weight: normal;"><input type="checkbox" name="features_awning" <%= caravan?.features && caravan.features.includes('awning') ? 'checked' : '' %>> Маркиза</label>
        <label style="font-weight: normal;"><input type="checkbox" name="features_bike_rack" <%= caravan?.features && caravan.features.includes('bike_rack') ? 'checked' : '' %>> Велостойка</label>
      </div>
      <div class="form-group">
        <label style="font-weight: normal;"><input type="checkbox" name="features_mosquito_nets" <%= caravan?.features && caravan.features.includes('mosquito_nets') ? 'checked' : '' %>> Москитные сетки</label>
        <label style="font-weight: normal;"><input type="checkbox" name="features_tv_mount" <%= caravan?.features && caravan.features.includes('tv_mount') ? 'checked' : '' %>> ТВ-кронштейн</label>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group" style="grid-column: 1 / -1;">
        <label>Пользовательская опция</label>
        <div class="custom-feature-inputs">
          <input type="text" id="customFeatureLabel" placeholder="Новая метка (напр. Отопление)" autocomplete="off">
          <button type="button" class="button is-light" id="addCustomFeatureBtn">Добавить</button>
        </div>
        <input type="hidden" name="custom_features_json" id="customFeaturesJson" value='<%= JSON.stringify(caravan?.custom_features_items || []) %>'>
        <div id="customFeatureCheckboxes" class="custom-features-list" style="display:flex;flex-direction:column;gap:0.5rem;margin-top:0.75rem;">
          <% (caravan?.custom_features_items || []).forEach((feature) => { %>
            <label class="custom-feature-checkbox-row" data-key="<%= feature.key %>">
              <input type="checkbox" class="custom-feature-checkbox" data-key="<%= feature.key %>" <%= caravan && caravan[feature.key] && caravan[feature.key] !== '0' ? 'checked' : '' %> >
              <span style="margin-left:0.5rem;"><%= feature.key %></span>
              <button type="button" class="button is-small is-danger is-light custom-feature-remove" style="margin-left:0.75rem;">Удалить</button>
            </label>
          <% }); %>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3><i class="fas fa-images"></i> Изображения</h3>
    <% if (caravan?.images && caravan.images.length > 0) { %>
      <div style="margin-bottom: 2rem;">
        <p style="margin-bottom: 1rem;"><strong>Текущие изображения (<%= caravan.images.length %>/30)</strong></p>
        <p style="margin-bottom: 0.75rem; color: #666; font-size: 0.9rem;">Перетащите значок перемещения в карточке, чтобы изменить порядок изображений.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem;" id="imagesGrid">
          <% caravan.images.forEach((img) => { %>
            <div class="image-card" data-image-id="<%= img.id %>" draggable="true" style="border: 1px solid #ddd; border-radius: 4px; overflow: hidden; position: relative; transition: opacity 0.2s;">
              <img src="<%= img.url %>" style="width: 100%; height: 120px; object-fit: cover; display: block;">
              <button type="button" class="drag-handle" aria-label="Переместить изображение" title="Переместить">
                <i class="fas fa-grip-vertical"></i>
              </button>
              <button type="button" class="delete-image-btn button is-danger is-light is-small" data-image-id="<%= img.id %>" style="width: 100%; padding: 0.5rem;">
                <i class="fas fa-trash"></i>
              </button>
              <div class="delete-marker" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255, 0, 0, 0.3); z-index: 1; border: 2px solid #ff3860; border-radius: 4px; justify-content: center; align-items: center;">
                <span style="color: #ff3860; font-weight: bold; background: white; padding: 0.5rem 1rem; border-radius: 4px;">Будет удалено</span>
              </div>
            </div>
            <input type="hidden" class="image-delete-input" name="images_to_delete" data-image-id="<%= img.id %>" value="<%= img.id %>" disabled>
          <% }); %>
        </div>
        <input type="hidden" id="imageOrderInput" name="image_order" value="<%= caravan.images.map((img) => img.id).join(',') %>">
      </div>
    <% } %>

    <div class="form-row">
      <div class="form-group" style="grid-column: 1 / -1;">
        <label>Добавить изображения</label>
        <input type="file" id="fileInput" name="images" multiple accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp">
      </div>
    </div>
  </div>

  <div class="form-actions form-actions--sticky">
    <button type="submit" class="button is-primary"><i class="fas fa-save mr-2"></i><%= isNew ? 'Создать' : 'Обновить' %></button>
    <% if (!isNew) { %>
      <button
        type="submit"
        form="listingActionForm"
        class="button <%= caravan && caravan.status === 'hidden' ? 'is-success' : 'is-warning' %>"
        data-confirm="<%= caravan && caravan.status === 'hidden' ? 'Показать прицеп-дачу в листинге?' : 'Скрыть прицеп-дачу с публикации?' %>"
      >
        <i class="fas <%= caravan?.status === 'hidden' ? 'fa-eye' : 'fa-eye-slash' %> mr-2"></i><%= caravan?.status === 'hidden' ? 'Показать' : 'Скрыть' %>
      </button>
    <% } %>
    <a href="/admin/dash" class="button is-light">Отмена</a>
  </div>
</form>

<% if (!isNew) { %>
  <form
    id="listingActionForm"
    method="POST"
    action="<%= caravan && caravan.status === 'hidden' ? ('/admin/edit/' + caravan.id + '/relist') : ('/admin/edit/' + caravan.id + '/delist') %>"
    hidden
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
  </form>
<% } %>

<!-- Page-specific logic: deletion toggles, ordering, FilePond setup -->
<script src="/public/js/bed-types.js"></script>
<script src="/public/js/multi-select.js"></script>
<script src="/public/vendor/filepond/filepond.min.js"></script>
<script src="/public/vendor/filepond-plugin-image-preview/filepond-plugin-image-preview.min.js"></script>
<script src="/public/vendor/sortablejs/Sortable.min.js"></script>
<script src="/public/js/admin-edit.js"></script>

<%- include('../../components/footer/admin') %>
