<%- include('../../components/header/public', { title: 'Контакты' }) %>
  <!-- Page-specific styles -->
  <link rel="stylesheet" href="/public/css/contact.css">

  <!-- Contacts Section -->
  <section class="section">
    <div class="container">
      <div class="contact-layout">
        <div class="contact-layout__map box">
          <iframe class="contact-layout__iframe" allowfullscreen allow="geolocation"
            src="https://yandex.ru/map-widget/v1/?um=constructor%3A5e54dd9bf37feeb45471c11000574dd109e3133a38c22019408db6ae39848881&amp;source=constructor" width="100%" height="400" frameborder="0">
          </iframe>
        </div>

        <div class="contact-layout__info">
          <div class="contact-layout__card box">
            <div class="contact-layout__item contact-layout__item--map">
              <div class="contact-layout__label">
                <i class="fas fa-map-marker-alt"></i>
                <span>Адрес</span>
              </div>
              <div class="contact-value">
                <p>Санкт-Петербург, Московский район</p>
              </div>
            </div>
          </div>

          <div class="contact-layout__card box">
            <div class="contact-layout__item contact-layout__item--phone">
              <div class="contact-layout__label">
                <i class="fas fa-phone"></i>
                <span>Телефон</span>
              </div>
              <div class="contact-value"><a href="tel:+7 (xxx) xxx-xx-xx">+7 (xxx) xxx-xx-xx</a></div>
            </div>
          </div>

          <div class="contact-layout__card box">
            <div class="contact-layout__item contact-layout__item--email">
              <div class="contact-layout__label">
                <i class="fas fa-envelope"></i>
                <span>Э-почта</span>
              </div>
              <div class="contact-value"><a href="mailto:info@recomte.ru">info@recomte.ru</a></div>
            </div>
          </div>

          <div class="contact-layout__card box">
            <div class="contact-layout__item contact-layout__item--time">
              <div class="contact-layout__label">
                <i class="fas fa-clock"></i>
                <span>Время работы</span>
              </div>
              <div class="contact-value contact-value--list">
                <ul class="contact-layout__hours-list">
                  <li>
                    <span class="day">Пн:</span>
                    <span class="time">10:00 - 17:00</span>
                  </li>
                  <li>
                    <span class="day">Вт:</span>
                    <span class="time">10:00 - 17:00</span>
                  </li>
                  <li>
                    <span class="day">Ср:</span>
                    <span class="time">10:00 - 17:00</span>
                  </li>
                  <li>
                    <span class="day">Чт:</span>
                    <span class="time">10:00 - 17:00</span>
                  </li>
                  <li>
                    <span class="day">Пт:</span>
                    <span class="time">10:00 - 17:00</span>
                  </li>
                  <li>
                    <span class="day">Сб:</span>
                    <span class="time">по договоренности</span>
                  </li>
                  <li>
                    <span class="day">Вс:</span>
                    <span class="time">по договоренности</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('../../components/footer/public') %>