<!DOCTYPE html>
<html lang="ru">
<head>
  <% const MAIN_SITE_URL = 'https://recomte.ru/'; %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken || '' %>">
  <title>recomte.ru | <%= title %></title>

  <link rel="icon" type="image/png" sizes="16x16" href="/public/images/favicons/favicon-orange-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/public/images/favicons/favicon-orange-32x32.png">
  <link rel="icon" type="image/png" sizes="180x180" href="/public/images/favicons/favicon-orange-180x180.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/public/images/favicons/favicon-orange-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/public/images/favicons/favicon-orange-512x512.png">
  <!-- Attribution: Caravan icons created by xnimrodx - Flaticon -->
  <div style="position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap;" aria-hidden="true">
    <a href="https://www.flaticon.com/free-icons/caravan" title="caravan icons">Caravan icons created by xnimrodx - Flaticon</a>
  </div>
  
  <link rel="stylesheet" href="/public/css/bulma.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body class="admin-page">
<nav class="navbar is-light">
  <div class="navbar-brand">
    <a href="/admin/dash" class="navbar-item">
      <h1 class="title is-4 mb-0">
        <i class="fas fa-cog mr-2"></i>Админ Панель
      </h1>
    </a>
    <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarMenu">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
  </div>
  <div id="navbarMenu" class="navbar-menu">
    <div class="navbar-end">
      <div class="navbar-item">
        <div class="buttons">
          <a href="<%= MAIN_SITE_URL %>" class="button is-info is-light">
            <span class="icon"><i class="fas fa-home"></i></span>
            <span>На главную</span>
          </a>
          <form method="POST" action="/admin/logout" style="display: inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>">
            <button class="button is-ghost">
              <span class="icon"><i class="fas fa-sign-out-alt"></i></span>
              <span>Выход</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</nav>

<section class="admin-section">
  <div class="container">
