<%- include('../layouts/admin-header', { title: isNew ? 'Новый кемпер' : 'Редактировать' }) %>

    <!-- Page Header -->
    <div class="admin-header">
      <h1><i class="fas fa-edit"></i> <%= isNew ? 'Новый кемпер' : 'Редактировать: ' + caravan.title %></h1>
    </div>

    <% if (error && typeof error !== 'undefined') { %>
      <div class="admin-error">
        <button class="delete"></button>
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="<%= isNew ? '/admin/new' : '/admin/edit/' + caravan.id %>" class="admin-form" enctype="multipart/form-data">
      <!-- Basic Info -->
      <div class="form-section">
        <h3><i class="fas fa-info-circle"></i> Основная информация</h3>
        
        <div class="form-row">
          <div class="form-group">
            <label>Название</label>
            <input type="text" name="title" placeholder="e.g., VW T5 2015" value="<%= caravan?.title || '' %>" required>
          </div>
          
          <div class="form-group">
            <label>Slug</label>
            <input type="text" name="slug" placeholder="vw-t5-2015" value="<%= caravan?.slug || '' %>" required>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group" style="grid-column: 1 / -1;">
            <label>Описание</label>
            <textarea name="description" placeholder="Подробное описание кемпера"><%= caravan?.description || '' %></textarea>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Цена (₽)</label>
            <input type="number" name="price" placeholder="2000000" value="<%= caravan?.price || '' %>" step="10" required>
          </div>
          
          <div class="form-group">
            <label>Год выпуска</label>
            <input type="number" name="year" placeholder="2000" value="<%= caravan?.year || '' %>" min="1950" max="2040">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Статус</label>
            <select name="status">
              <option value="available" <%= caravan?.status === 'available' ? 'selected' : '' %>>В наличии</option>
              <option value="reserved" <%= caravan?.status === 'reserved' ? 'selected' : '' %>>Зарезервировано</option>
              <option value="sold" <%= caravan?.status === 'sold' ? 'selected' : '' %>>Продано</option>
            </select>
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="featured" <%= caravan?.featured ? 'checked' : '' %>>
              Показывать на главной
            </label>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Спальных мест</label>
            <input type="number" name="beds_count" placeholder="2" value="<%= caravan?.beds_count || '' %>">
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="winter_rated" <%= caravan?.winter_rated ? 'checked' : '' %>>
              Зимний кемпер
            </label>
          </div>
        </div>
      </div>

      <!-- Comfort & Layout -->
      <div class="form-section">
        <h3><i class="fas fa-bed"></i> Комфорт и ванная</h3>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_shower" <%= caravan?.has_shower ? 'checked' : '' %>>
              Душ
            </label>
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_toilet" <%= caravan?.has_toilet ? 'checked' : '' %>>
              Туалет
            </label>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Тип туалета</label>
            <input type="text" name="toilet_type" placeholder="Биологический" value="<%= caravan?.toilet_type || '' %>">
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="sink_present" <%= caravan?.sink_present ? 'checked' : '' %>>
              Раковина
            </label>
          </div>
        </div>
      </div>

      <!-- Water Systems -->
      <div class="form-section">
        <h3><i class="fas fa-water"></i> Водные системы</h3>
        
        <div class="form-row">
          <div class="form-group">
            <label>Бак пресной воды (л)</label>
            <input type="number" name="fresh_water_tank_l" placeholder="100" value="<%= caravan?.fresh_water_tank_l || '' %>">
          </div>
          
          <div class="form-group">
            <label>Бак серой воды (л)</label>
            <input type="number" name="grey_water_tank_l" placeholder="100" value="<%= caravan?.grey_water_tank_l || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_hot_water" <%= caravan?.has_hot_water ? 'checked' : '' %>>
              Горячее водоснабжение
            </label>
          </div>
          
          <div class="form-group">
            <label>Тип горячей воды</label>
            <input type="text" name="water_heater_type" placeholder="Электрический" value="<%= caravan?.water_heater_type || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Объём бойлера (л)</label>
            <input type="number" name="boiler_volume_l" placeholder="15" value="<%= caravan?.boiler_volume_l || '' %>">
          </div>
        </div>
      </div>

      <!-- Kitchen -->
      <div class="form-section">
        <h3><i class="fas fa-utensils"></i> Кухня</h3>
        
        <div class="form-row">
          <div class="form-group">
            <label>Тип холодильника</label>
            <input type="text" name="fridge_type" placeholder="Электрический" value="<%= caravan?.fridge_type || '' %>">
          </div>
          
          <div class="form-group">
            <label>Объём холодильника (л)</label>
            <input type="number" name="fridge_volume_l" placeholder="150" value="<%= caravan?.fridge_volume_l || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_cooktop" <%= caravan?.has_cooktop ? 'checked' : '' %>>
              Плита
            </label>
          </div>
          
          <div class="form-group">
            <label>Тип плиты</label>
            <input type="text" name="cooktop_type" placeholder="Газовая" value="<%= caravan?.cooktop_type || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Количество конфорок</label>
            <input type="number" name="stove_burners_count" placeholder="2" value="<%= caravan?.stove_burners_count || '' %>">
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_oven" <%= caravan?.has_oven ? 'checked' : '' %>>
              Духовка
            </label>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Количество розеток</label>
            <input type="number" name="kitchen_outlets_count" placeholder="3" value="<%= caravan?.kitchen_outlets_count || '' %>">
          </div>
        </div>
      </div>

      <!-- Heating -->
      <div class="form-section">
        <h3><i class="fas fa-fire"></i> Отопление</h3>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_heating" <%= caravan?.has_heating ? 'checked' : '' %>>
              Отопление
            </label>
          </div>
          
          <div class="form-group">
            <label>Тип отопления</label>
            <input type="text" name="heating_type" placeholder="Водяное" value="<%= caravan?.heating_type || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Марка отопления</label>
            <input type="text" name="heater_brand" placeholder="Truma" value="<%= caravan?.heater_brand || '' %>">
          </div>
          
          <div class="form-group">
            <label>Источник отопления</label>
            <input type="text" name="heating_source" placeholder="Дизель/электро" value="<%= caravan?.heating_source || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Распределение тепла</label>
            <input type="text" name="heating_distribution" placeholder="Воздушная/водяная" value="<%= caravan?.heating_distribution || '' %>">
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_insulation" <%= caravan?.has_insulation ? 'checked' : '' %>>
              Изоляция
            </label>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="double_glazed_windows" <%= caravan?.double_glazed_windows ? 'checked' : '' %>>
              Двойное остекление
            </label>
          </div>
        </div>
      </div>

      <!-- Electrical System -->
      <div class="form-section">
        <h3><i class="fas fa-plug"></i> Электроснабжение</h3>
        
        <div class="form-row">
          <div class="form-group">
            <label>Тип батареи</label>
            <input type="text" name="battery_type" placeholder="Литий" value="<%= caravan?.battery_type || '' %>">
          </div>
          
          <div class="form-group">
            <label>Ёмкость батареи (Ач)</label>
            <input type="number" name="battery_capacity_ah" placeholder="200" value="<%= caravan?.battery_capacity_ah || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Инвертор (W)</label>
            <input type="number" name="inverter_wattage" placeholder="3000" value="<%= caravan?.inverter_wattage || '' %>">
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_12v_system" <%= caravan?.has_12v_system ? 'checked' : '' %>>
              12V система
            </label>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_solar_panels" <%= caravan?.has_solar_panels ? 'checked' : '' %>>
              Солнечные панели
            </label>
          </div>
          
          <div class="form-group">
            <label>Мощность панелей (W)</label>
            <input type="number" name="solar_wattage" placeholder="400" value="<%= caravan?.solar_wattage || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="has_shore_power" <%= caravan?.has_shore_power ? 'checked' : '' %>>
              "Береговое" питание
            </label>
          </div>
        </div>
      </div>

      <!-- Dimensions & Weight -->
      <div class="form-section">
        <h3><i class="fas fa-ruler"></i> Размеры и вес</h3>
        
        <div class="form-row">
          <div class="form-group">
            <label>Длина (мм)</label>
            <input type="number" name="length_mm" placeholder="6000" value="<%= caravan?.length_mm || '' %>">
          </div>
          
          <div class="form-group">
            <label>Ширина (мм)</label>
            <input type="number" name="width_mm" placeholder="2400" value="<%= caravan?.width_mm || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Высота (мм)</label>
            <input type="number" name="height_mm" placeholder="2900" value="<%= caravan?.height_mm || '' %>">
          </div>
          
          <div class="form-group">
            <label>Внутренняя высота (мм)</label>
            <input type="number" name="interior_height_mm" placeholder="2000" value="<%= caravan?.interior_height_mm || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Вес пустой (кг)</label>
            <input type="number" name="weight_empty_kg" placeholder="1500" value="<%= caravan?.weight_empty_kg || '' %>">
          </div>
          
          <div class="form-group">
            <label>Макс. вес (кг)</label>
            <input type="number" name="max_weight_kg" placeholder="2000" value="<%= caravan?.max_weight_kg || '' %>">
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label>Тип оси</label>
            <input type="text" name="axle_type" placeholder="Одинарная" value="<%= caravan?.axle_type || '' %>">
          </div>
        </div>
      </div>

      <!-- Amenities & Features -->
      <div class="form-section">
        <h3><i class="fas fa-star"></i> Удобства и опции</h3>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="features_air_conditioning" <%= caravan?.features && caravan.features.includes('air_conditioning') ? 'checked' : '' %>>
              Кондиционер
            </label>
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="features_awning" <%= caravan?.features && caravan.features.includes('awning') ? 'checked' : '' %>>
              Маркиза
            </label>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="features_bike_rack" <%= caravan?.features && caravan.features.includes('bike_rack') ? 'checked' : '' %>>
              Велосипедная стойка
            </label>
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="features_mosquito_nets" <%= caravan?.features && caravan.features.includes('mosquito_nets') ? 'checked' : '' %>>
              Москитные сетки
            </label>
          </div>
        </div>
        
        <div class="form-row">
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="features_tv_mount" <%= caravan?.features && caravan.features.includes('tv_mount') ? 'checked' : '' %>>
              ТВ кронштейн
            </label>
          </div>
          
          <div class="form-group">
            <label style="font-weight: normal;">
              <input type="checkbox" name="features_storage_compartments" <%= caravan?.features && caravan.features.includes('storage_compartments') ? 'checked' : '' %>>
              Отсеки для хранения
            </label>
          </div>
        </div>
      </div>

      <!-- Images -->
      <div class="form-section">
        <h3><i class="fas fa-images"></i> Изображения</h3>
        
        <% if (caravan?.images && caravan.images.length > 0) { %>
          <div style="margin-bottom: 2rem;">
            <p style="margin-bottom: 1rem;"><strong>Текущие изображения (<%= caravan.images.length %>/30)</strong></p>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 1rem;" id="imagesGrid">
              <% caravan.images.forEach((img, idx) => { %>
                <div class="image-card" data-image-id="<%= img.id %>" style="border: 1px solid #ddd; border-radius: 4px; overflow: hidden; position: relative; transition: opacity 0.2s;">
                  <img src="<%= img.url %>" style="width: 100%; height: 120px; object-fit: cover; display: block;">
                  <button type="button" class="delete-image-btn button is-danger is-light is-small" data-image-id="<%= img.id %>" style="width: 100%; padding: 0.5rem;">
                    <i class="fas fa-trash"></i>
                  </button>
                  <div class="delete-marker" style="display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255, 0, 0, 0.3); z-index: 1; border: 2px solid #ff3860; border-radius: 4px; justify-content: center; align-items: center;">
                    <span style="color: #ff3860; font-weight: bold; background: white; padding: 0.5rem 1rem; border-radius: 4px;">Будет удалено</span>
                  </div>
                </div>
                <input type="hidden" class="image-delete-input" name="images_to_delete" data-image-id="<%= img.id %>" value="<%= img.id %>" disabled>
              <% }); %>
            </div>
          </div>
        <% } %>
        
        <div class="form-row">
          <div class="form-group" style="grid-column: 1 / -1;">
            <label>Добавить изображения</label>
            <input type="file" id="fileInput" name="images" multiple accept="image/*" style="display: none;">
            <label for="fileInput" class="file-input-label">
              <i class="fas fa-cloud-upload-alt"></i> Выбрать файлы
            </label>
            <p style="margin-top: 0.5rem; font-size: 0.875rem; color: #666;">Макс. 30 изображений на кемпер</p>
          </div>
        </div>
      </div>

      <!-- Submit -->
      <div class="form-actions">
        <button type="submit" class="button is-primary">
          <i class="fas fa-save"></i> <%= caravan ? 'Обновить' : 'Создать' %>
        </button>
        <a href="/admin/dash" class="button is-light">Отмена</a>
      </div>
    </form>

    <script src="/public/js/admin-edit.js"></script>

<%- include('../layouts/admin-footer') %>
