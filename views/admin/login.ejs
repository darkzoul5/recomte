<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | Recomte.ru</title>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bulma/0.9.4/bulma.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="has-background-light">

<section class="section is-fullheight is-flex is-align-items-center is-justify-content-center">
  <div class="box" style="width: 100%; max-width: 400px;">
    <h1 class="title has-text-centered mb-5">
      <i class="fas fa-lock has-text-primary"></i> Admin Panel
    </h1>

    <% if (error) { %>
      <div class="notification is-danger is-light">
        <button class="delete"></button>
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/admin/login">
      <div class="field">
        <label class="label">Пароль</label>
        <div class="control has-icons-left">
          <input class="input" type="password" name="password" placeholder="Введите пароль" required autofocus>
          <span class="icon is-small is-left">
            <i class="fas fa-key"></i>
          </span>
        </div>
      </div>

      <div class="field">
        <div class="control">
          <button class="button is-primary is-fullwidth is-medium">
            <span class="icon">
              <i class="fas fa-sign-in-alt"></i>
            </span>
            <span>Войти</span>
          </button>
        </div>
      </div>
    </form>

    <div class="content has-text-centered mt-5">
      <p class="help">Защищенная область администратора</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.delete').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.target.closest('.notification').remove();
    });
  });
</script>

</body>
</html>
