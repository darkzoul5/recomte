<%- include('layouts/header', { title }) %>

<!-- Caravan Detail Section -->
<section class="section">
  <div class="container">
    <nav class="breadcrumb mb-5" aria-label="breadcrumbs">
      <ul>
        <li><a href="/">Главная</a></li>
        <li><a href="/caravans">Каталог</a></li>
        <li class="is-active"><a aria-current="page"><%= caravan.title %></a></li>
      </ul>
    </nav>

    <div class="columns">
      <!-- Images Gallery -->
      <div class="column is-two-thirds">
        <div class="mb-5">
          <% if (caravan.images && caravan.images.length > 0) { %>
            <!-- Main image -->
            <figure class="image is-3by2 mb-4">
              <img id="mainImage" src="<%= caravan.images[0].url %>" alt="<%= caravan.title %>" style="object-fit: cover;">
            </figure>
            
            <!-- Thumbnail gallery -->
            <% if (caravan.images.length > 1) { %>
              <div class="is-flex is-flex-wrap-wrap" style="gap: 0.5rem;">
                <% caravan.images.forEach((img, index) => { %>
                  <figure class="image" style="width: 100px; height: 75px; cursor: pointer;" onclick="document.getElementById('mainImage').src = '<%= img.url %>';">
                    <img src="<%= img.url %>" alt="Изображение <%= index + 1 %>" style="object-fit: cover; border: 2px solid transparent;" 
                         onmouseover="this.style.borderColor='#00d1b2'" onmouseout="this.style.borderColor='transparent'">
                  </figure>
                <% }); %>
              </div>
            <% } %>
          <% } else { %>
            <figure class="image is-3by2">
              <img src="https://via.placeholder.com/800x600?text=Без+изображений" alt="<%= caravan.title %>">
            </figure>
          <% } %>
        </div>
      </div>

      <!-- Details Sidebar -->
      <div class="column">
        <div class="box">
          <h1 class="title is-3"><%= caravan.title %></h1>
          
          <div class="mb-5">
            <p class="is-size-5 has-text-weight-bold has-text-primary">
              <strong><%= caravan.price.toLocaleString('ru-RU') %> ₽</strong>
            </p>
            <% if (caravan.status === 'sold') { %>
              <p class="tag is-danger is-medium">ПРОДАНО</p>
            <% } else { %>
              <p class="tag is-success is-medium">В НАЛИЧИИ</p>
            <% } %>
          </div>

          <!-- Key specs -->
          <div class="mb-5">
            <h3 class="subtitle is-5">Основные характеристики</h3>
            <table class="table is-fullwidth is-narrow">
              <tbody>
                <% if (caravan.year) { %>
                  <tr>
                    <td><strong>Год выпуска:</strong></td>
                    <td><%= caravan.year %></td>
                  </tr>
                <% } %>
                <% if (caravan.beds_count) { %>
                  <tr>
                    <td><strong>Спальных мест:</strong></td>
                    <td><%= caravan.beds_count %></td>
                  </tr>
                <% } %>
                <% if (caravan.length_mm) { %>
                  <tr>
                    <td><strong>Длина:</strong></td>
                    <td><%= (caravan.length_mm / 1000).toFixed(2) %> м</td>
                  </tr>
                <% } %>
                <% if (caravan.weight_empty_kg) { %>
                  <tr>
                    <td><strong>Вес пустой:</strong></td>
                    <td><%= caravan.weight_empty_kg %> кг</td>
                  </tr>
                <% } %>
                <% if (caravan.winter_rated) { %>
                  <tr>
                    <td><strong>Зимний рейтинг:</strong></td>
                    <td><span class="tag is-primary">✓ Да</span></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- Contact button -->
          <a href="/contact" class="button is-primary is-fullwidth is-medium mb-3">
            <span class="icon">
              <i class="fas fa-phone"></i>
            </span>
            <span>Связаться с нами</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Full Description -->
    <% if (caravan.description) { %>
      <div class="box mt-5">
        <h2 class="subtitle is-4">Описание</h2>
        <p><%= caravan.description %></p>
      </div>
    <% } %>

    <!-- Detailed specs if available -->
    <% if (caravan.has_shower || caravan.has_toilet || caravan.shower_type || caravan.fridge_volume_l || caravan.fresh_water_tank_l || caravan.condition) { %>
      <div class="box mt-5">
        <h2 class="subtitle is-4">Детальные характеристики</h2>
        
        <div class="columns is-multiline">
          <!-- Sleeping & Comfort -->
          <% if (caravan.shower_type || caravan.toilet_type || caravan.bed_layout || caravan.windows_count) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6">Спальня и ванная</h4>
              <ul>
                <% if (caravan.shower_type) { %><li>Душ: <%= caravan.shower_type === 'none' ? 'Нет' : (caravan.shower_type === 'separate' ? 'Отдельная' : 'Комбинированная') %></li><% } %>
                <% if (caravan.toilet_type) { %><li>Туалет: <%= caravan.toilet_type %></li><% } %>
                <% if (caravan.bed_layout) { %><li>Кровати: <%= caravan.bed_layout %></li><% } %>
                <% if (caravan.windows_count) { %><li>Окон: <%= caravan.windows_count %></li><% } %>
                <% if (caravan.door_position) { %><li>Дверь: <%= caravan.door_position === 'left' ? 'Левая' : (caravan.door_position === 'right' ? 'Правая' : 'С обеих сторон') %></li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.fresh_water_tank_l || caravan.grey_water_tank_l) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6">Водные системы</h4>
              <ul>
                <% if (caravan.fresh_water_tank_l) { %><li>Пресная вода: <%= caravan.fresh_water_tank_l %> л</li><% } %>
                <% if (caravan.grey_water_tank_l) { %><li>Серая вода: <%= caravan.grey_water_tank_l %> л</li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.cooktop_type || caravan.stove_burners_count) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6">Кухня</h4>
              <ul>
                <% if (caravan.fridge_type) { %><li>Холодильник: <%= caravan.fridge_type %></li><% } %>
                <% if (caravan.cooktop_type) { %><li>Плита: <%= caravan.cooktop_type %></li><% } %>
                <% if (caravan.stove_burners_count) { %><li>Конфорок: <%= caravan.stove_burners_count %></li><% } %>
                <% if (caravan.kitchen_outlets_count) { %><li>Розеток: <%= caravan.kitchen_outlets_count %></li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.heating_type || caravan.has_ac || caravan.vent_fans_count) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6">Климат и отопление</h4>
              <ul>
                <% if (caravan.heating_type) { %><li>Отопление: <%= caravan.heating_type %></li><% } %>
                <% if (caravan.heating_source) { %><li>Источник: <%= caravan.heating_source %></li><% } %>
                <% if (caravan.has_ac) { %><li><i class="fas fa-check has-text-success"></i> Кондиционер</li><% } %>
                <% if (caravan.vent_fans_count) { %><li>Вентиляторов: <%= caravan.vent_fans_count %></li><% } %>
                <% if (caravan.skylights_count) { %><li>Люков: <%= caravan.skylights_count %></li><% } %>
              </ul>
            </div>
          <% } %>

          <% if (caravan.battery_type || caravan.solar_wattage || caravan.has_shore_power) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6">Электричество</h4>
              <ul>
                <% if (caravan.battery_type) { %><li>Батарея: <%= caravan.battery_type %></li><% } %>
                <% if (caravan.battery_capacity_ah) { %><li>Ёмкость: <%= caravan.battery_capacity_ah %> Ач</li><% } %>
                <% if (caravan.solar_wattage) { %><li>Солнечные панели: <%= caravan.solar_wattage %> W</li><% } %>
                <% if (caravan.has_shore_power) { %><li><i class="fas fa-check has-text-success"></i> "Береговое" питание</li><% } %>
              </ul>
            </div>
          <% } %>

          <!-- Phase 1 Fields: Gas System -->
          <% if (caravan.gas_system_present || caravan.gas_bottles_count) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6">Газовая система</h4>
              <ul>
                <% if (caravan.gas_system_present) { %><li><i class="fas fa-check has-text-success"></i> Газовая система</li><% } %>
                <% if (caravan.gas_bottles_count) { %><li>Баллонов: <%= caravan.gas_bottles_count %></li><% } %>
              </ul>
            </div>
          <% } %>

          <!-- Phase 1 Fields: Chassis & Towing -->
          <% if (caravan.axles_count || caravan.brake_type || caravan.license_requirement) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6">Шасси и буксировка</h4>
              <ul>
                <% if (caravan.axles_count) { %><li>Осей: <%= caravan.axles_count %></li><% } %>
                <% if (caravan.brake_type) { %><li>Тормоза: <%= caravan.brake_type === 'hydraulic' ? 'Гидравлические' : (caravan.brake_type === 'electric' ? 'Электрические' : 'Барабанные') %></li><% } %>
                <% if (caravan.suspension_type) { %><li>Подвеска: <%= caravan.suspension_type %></li><% } %>
                <% if (caravan.wheel_size_inch) { %><li>Колеса: <%= caravan.wheel_size_inch %>"</li><% } %>
                <% if (caravan.hitch_weight_kg) { %><li>Масса сцепки: <%= caravan.hitch_weight_kg %> кг</li><% } %>
                <% if (caravan.recommended_tow_vehicle_min_kg) { %><li>Мин. вес авто: <%= caravan.recommended_tow_vehicle_min_kg %> кг</li><% } %>
                <% if (caravan.braked) { %><li><i class="fas fa-check has-text-success"></i> С тормозами на оси</li><% } %>
                <% if (caravan.stabilizer_present) { %><li><i class="fas fa-check has-text-success"></i> Стабилизатор</li><% } %>
                <% if (caravan.license_requirement) { %><li>Прав: <%= caravan.license_requirement %></li><% } %>
              </ul>
            </div>
          <% } %>

          <!-- Phase 1 Fields: Condition -->
          <% if (caravan.condition || caravan.damp_detected || caravan.last_service_date || caravan.ownership_count) { %>
            <div class="column is-one-third">
              <h4 class="subtitle is-6">Состояние и история</h4>
              <ul>
                <% if (caravan.condition) { %><li>Состояние: <%= caravan.condition === 'excellent' ? 'Отличное' : (caravan.condition === 'good' ? 'Хорошее' : (caravan.condition === 'fair' ? 'Удовлетворительное' : 'Требует ремонта')) %></li><% } %>
                <% if (caravan.damp_detected) { %><li><i class="fas fa-exclamation-triangle has-text-warning"></i> Обнаружена сырость</li><% } %>
                <% if (caravan.last_service_date) { %><li>Последнее обслуживание: <%= new Date(caravan.last_service_date).toLocaleDateString('ru-RU') %></li><% } %>
                <% if (caravan.ownership_count) { %><li>Владельцев: <%= caravan.ownership_count %></li><% } %>
              </ul>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('layouts/footer') %>
