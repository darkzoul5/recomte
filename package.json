{
  "name": "recomte-ru",
  "version": "1.0.0",
  "description": "European caravan sales platform",
  "main": "src/server/index.ts",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "start": "node --experimental-strip-types src/server/index.ts",
    "start:public": "node --experimental-strip-types src/server/public.ts",
    "start:admin": "node --experimental-strip-types src/server/admin.ts",
    "lint": "eslint . --max-warnings=0",
    "css:build": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/website.css --minify",
    "css:watch": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/website.css --watch",
    "db:init": "node --experimental-strip-types scripts/init-db.ts",
    "db:seed": "node --experimental-strip-types scripts/seed-db.ts",
    "db:migrations": "node --experimental-strip-types scripts/migrate-db.ts",
    "db:backup": "node --experimental-strip-types scripts/backup-db.ts",
    "admin:passwd": "node --experimental-strip-types scripts/admin-password-reset.ts"
  },
  "author": "dark_zoul",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^10.0.0",
    "@fastify/view": "^12.0.0",
    "@tailwindcss/cli": "^4.3.0",
    "argon2": "^0.45.0",
    "better-sqlite3": "^13.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "fastify": "^5.8.5",
    "filepond": "^4.32.12",
    "filepond-plugin-image-preview": "^4.6.12",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.0",
    "slugify": "^1.6.9",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "pino-pretty": "^13.1.3"
  }
}
