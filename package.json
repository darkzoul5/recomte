{
  "name": "recomte-ru",
  "version": "1.0.0",
  "description": "European caravan sales platform",
  "main": "src/server/index.js",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node src/server/index.js",
    "start:public": "node src/server/public.js",
    "start:admin": "node src/server/admin.js",
    "lint": "eslint . --max-warnings=0",
    "css:build": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/website.css --minify",
    "css:watch": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/website.css --watch",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed-db.js",
    "db:migrations": "node scripts/migrate-db.js",
    "db:backup": "node scripts/backup-db.js",
    "admin:passwd": "node scripts/admin-password-reset.js"
  },
  "author": "dark_zoul",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "@tailwindcss/cli": "^4.3.0",
    "argon2": "^0.45.0",
    "better-sqlite3": "^13.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "fastify": "^5.12.3",
    "filepond": "^4.32.12",
    "filepond-plugin-image-preview": "^4.6.12",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.0",
    "slugify": "^1.6.9",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "git-cliff": "^2.13.1",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3"
  }
}
